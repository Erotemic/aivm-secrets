          after_registry
      if b2
      then ok (core.result.Result.Ok trust.RecoveryPhase.Activated)
      else ok (core.result.Result.Err trust.TrustDenial.Stale)
    else ok (core.result.Result.Err trust.TrustDenial.Stale)

