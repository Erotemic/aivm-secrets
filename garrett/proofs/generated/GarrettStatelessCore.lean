      token_id now lifetime
  | oauth_login.Stage.Complete =>
    ok (core.result.Result.Err stateless.Rejection.Malformed)
  | oauth_login.Stage.Uncertain =>
    ok (core.result.Result.Err stateless.Rejection.Malformed)

