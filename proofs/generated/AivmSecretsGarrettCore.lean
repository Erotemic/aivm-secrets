  then
    let b1 ←
      alloc.vec.partial_eq.PartialEqVec.eq core.cmp.PartialEqU8 registry
        before_registry
    if b1
    then ok (core.result.Result.Ok trust.RecoveryPhase.Unchanged)
    else
      let b2 ←
        alloc.vec.partial_eq.PartialEqVec.eq core.cmp.PartialEqU8 registry
