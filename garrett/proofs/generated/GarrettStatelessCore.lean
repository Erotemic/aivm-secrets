  let o ← stateless_proxy.surrogate_of s
  match o with
  | none => ok (stateless_proxy.Decision.Unauthorized none)
  | some token =>
    let s1 := alloc.vec.Vec.deref token
    let r ←
      stateless.authenticate statelessSurrogateOpenerInst opener s1 acceptance
        peer now
