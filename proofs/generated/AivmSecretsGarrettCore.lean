        else
          if claims.epoch < 0#i64
          then ok (core.result.Result.Err Denial.InvalidCapability)
          else
            if claims.epoch > 2147483647#i64
            then ok (core.result.Result.Err Denial.InvalidCapability)
            else
              if claims.epoch != expected.epoch
              then ok (core.result.Result.Err Denial.InvalidCapability)
              else
                if claims.issued_at < 0#i64
