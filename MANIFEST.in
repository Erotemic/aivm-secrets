include LICENSE README.md AGENTS.md
include .github/workflows/freshness.yml
include .github/workflows/garrett.yml
graft docs
graft tests
recursive-include dev/port *.json *.txt *.py
recursive-include dev/verification *.py
include rust/Cargo.toml rust/Cargo.lock rust/rust-toolchain.toml
recursive-include rust/crates *.rs *.toml
include proofs/lean-toolchain proofs/lakefile.lean proofs/lake-manifest.json
include proofs/manifest.json proofs/Freshness.lean proofs/Check.lean
include proofs/garrett-manifest.json proofs/Garrett.lean proofs/GarrettSecrecy.lean proofs/GarrettCheck.lean proofs/GarrettProtocol.lean
include proofs/GarrettHistory.lean
include proofs/GarrettEnrollment.lean
include proofs/GarrettAuthority.lean
include proofs/GarrettTrust.lean
include proofs/GarrettOAuth.lean
include proofs/GarrettLogin.lean
include proofs/GarrettManifest.lean
recursive-include proofs/generated *.lean
prune rust/target
prune proofs/.lake
global-exclude __pycache__ *.py[cod]
