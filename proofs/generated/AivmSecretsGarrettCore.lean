def trust.recovery_phase
  (anchor : alloc.vec.Vec Std.U8) (before_anchor : alloc.vec.Vec Std.U8)
  (after_anchor : alloc.vec.Vec Std.U8) (registry : alloc.vec.Vec Std.U8)
