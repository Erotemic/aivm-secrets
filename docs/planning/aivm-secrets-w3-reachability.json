  "effect_classes": [
    {
      "id": "provider-preflight",
      "sink": "S-PROVIDER-HTTPS",
      "scope": "primary",
      "reachable_from": "tls::Bridge::answer(request)->ProviderSession::request->manifest::Session::request",
      "constructor": "Policy::preflight->PreparedDispatch::preflight",
      "interpreter": "dispatch->Executor::exchange_manifest"
    },
    {
      "id": "provider-final",
      "sink": "S-PROVIDER-HTTPS",
      "scope": "primary",
      "reachable_from": "tls::Bridge::answer(request)->ProviderSession::request->manifest::Session::request",
      "constructor": "Policy::final_effect->PreparedDispatch::final_effect",
      "interpreter": "dispatch->Executor::exchange_manifest"
    },
    {
      "id": "guest-reply",
      "sink": "S-GUEST-FRAME",
      "scope": "primary",
      "reachable_from": "tls::Bridge::serve->answer(request|describe|renounce)",
      "constructor": "manifest::Session::request->Disclosure::project / Session::control",
      "interpreter": "GuestFrame::from_answer->send"
    },
    {
      "id": "guest-denial",
      "sink": "S-GUEST-FRAME",
      "scope": "primary",
      "reachable_from": "tls::Bridge::serve->answer or frame parse failure",
      "constructor": "Error::code->tls::failure",
      "interpreter": "GuestFrame::from_answer->send"
    },
    {
      "id": "host-audit",
      "sink": "S-HOST-AUDIT",
      "scope": "primary",
      "reachable_from": "manifest::Session::start/issue/request/control; separate owner-only approval::Shared",
      "constructor": "dispatch, completed, renounced, issued, session_open, approval_requested/approved/revoked metadata in the approval extension",
      "interpreter": "custody::Audit::write_record (sync_all)"
    },
    {
      "id": "host-announcement",
      "sink": "S-HOST-STDOUT",
      "scope": "primary",
      "reachable_from": "bridge_main::serve startup",
      "constructor": "legacy_bridge/authority::bridge_from_config",
      "interpreter": "bridge_main stdout canonical announcement"
    },
    {
      "id": "legacy-forward",
      "sink": "S-LEGACY-UNIX",
      "scope": "delegated",
      "reachable_from": "tls::Bridge::answer when Backend::Socket",
      "constructor": "opened inner capability to host-selected broker_socket",
      "interpreter": "tls::Bridge::forward->UnixStream"
    },
    {
      "id": "oauth-startup",
      "sink": "S-OAUTH-HTTPS",
      "scope": "operator_only",
      "reachable_from": "ProviderSession::start->OAuthSource::session_snapshot",
      "constructor": "host-authorized OAuth refresh/acquisition",
      "interpreter": "oauth_vault::transport TLS adapter"
    },
    {
      "id": "host-private",
      "sink": "S-HOST-PRIVATE-STATE",
      "scope": "operator_only",
      "reachable_from": "authority startup/enrollment, vault, grant storage and audit",
      "constructor": "operator files, encrypted custody, authority state",
      "interpreter": "files::PrivateDirectory and oauth_vault persistence"
    },
    {
      "id": "host-control",
      "sink": "S-HOST-ADMIN",
      "scope": "operator_only",
      "reachable_from": "separate garrett-authority / garrett-oauth binaries",
      "constructor": "privileged operator requests",
      "interpreter": "authority_main / oauth_main"
    },
    {
      "id": "guest-close",
      "sink": "S-GUEST-CLOSE",
      "scope": "primary",
      "reachable_from": "bridge_main::serve->tls::Bridge::serve",
      "constructor": "TLS handshake, deadline, parse/adapter failure or successful answer",
      "interpreter": "tls stream close_notify / connection shutdown"
    },
    {
      "id": "authority-coordinate",
      "sink": "S-COORDINATOR-HTTPS",
      "scope": "primary",
      "reachable_from": "AccountSession/manifest_session request, late provider check and control; keyed final dispatch",
      "constructor": "host-selected Coordinator and derived principal/client-key/request hashes",
      "interpreter": "coordination::Coordinator::call and extracted coordination::dispatch"
    },
    {
      "id": "coordination-authority",
      "scope": "operator_only",
      "reachable_from": [
        "garrett-coordinator serve; separate host-selected mTLS authority handler"
      ],
      "constructor": "coordinator_authority::Ledger::handle (typed core decisions inside SQLite transaction)",
      "interpreter": "coordinator_authority::server::exchange (fixed bounded reply after committed decision)",
      "sink": "S-COORDINATOR-REPLY"
    },
    {
      "id": "operator-coordinate",
      "sink": "S-COORDINATOR-ADMIN",
      "scope": "operator_only",
      "reachable_from": "separate garrett-coordinatorctl binary / coordinator_admin::Client",
      "constructor": "host-selected Coordinator::operator and validated member pins",
      "interpreter": "shared coordination::Coordinator::exchange with conservative post-send operator outcomes"
    },
    {
      "id": "write-approval-control",
      "sink": "S-WRITE-APPROVAL-CONTROL",
      "scope": "operator_only",
      "reachable_from": "bridge_main startup selects separate host_control::Control; fixed independent worker pool",
      "constructor": "owner SO_PEERCRED plus bounded strict command -> Shared::execute",
      "interpreter": "Shared pending/issue/revoke with extracted approval::issue/consume; fixed canonical host reply"
    }
  ]
}
